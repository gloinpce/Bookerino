{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Main GUI (Desktop App)",
            "request": "launch",
            "mainClass": "com.bookerino.MainGUI",
            "projectName": "bookerino",
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "jdbc:sqlite:./bookerino.db"
            },
            "args": [],
            "vmArgs": []
        },
        {
            "type": "java",
            "name": "Main (Console)",
            "request": "launch",
            "mainClass": "com.bookerino.Main",
            "projectName": "bookerino",
            "cwd": "${workspaceFolder}",
            "env": {
                "DATABASE_URL": "jdbc:sqlite:./bookerino.db"
            },
            "args": [],
            "vmArgs": []
        },
        {
            "type": "java",
            "name": "Main (Executable JAR)",
            "request": "launch",
            "mainClass": "com.bookerino.Main",
            "projectName": "bookerino",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/target/bookerino-desktop.jar"
            ],
            "env": {
                "DATABASE_URL": "jdbc:sqlite:./bookerino.db"
            }
        }
    ]
}