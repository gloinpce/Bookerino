# Environment Variables Template for Bookerino Client
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to repository

# Stack Auth Configuration (Required for authentication)
# Get these from https://app.stack-auth.com
VITE_STACK_PROJECT_ID=your_project_id_here
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your_publishable_key_here
# Note: VITE_STACK_SECRET_SERVER_KEY should NOT be exposed to client-side code

# Database Configuration (Required for database operations)
VITE_DATABASE_URL=your_neon_database_url_here

# Application Configuration
VITE_NODE_ENV=development
VITE_PORT=3000
VITE_DEBUG=true
VITE_LOG_LEVEL=verbose
